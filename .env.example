# oh-my-sage 网页版配置文件
# 复制为 .env 后填写，不要提交 .env。

# ==================== LLM 配置 ====================

# OpenAI 兼容接口地址和模型名称，可选服务商见 README「方式二：网页版」
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-6.1-terra

# 你的 API Key，必填
LLM_API_KEY=

# 温度（可选，默认 0.7）
# LLM_TEMPERATURE=0.7

# ==================== 网关配置 ====================

# 米家中枢网关地址，必填，例如 http://192.168.0.5
GATEWAY_URL=

# ==================== Web 安全配置（可选） ====================

# Web 控制台访问口令（局域网/反向代理暴露时强烈建议配置）
# WEB_AUTH_TOKEN=

# 允许访问 Web API 的额外 Host 列表（逗号分隔，默认仅允许 localhost,127.0.0.1,[::1]）
# WEB_ALLOWED_HOSTS=

# 是否允许加载宿主机 ~/.agents/skills 下的个人全局 Skills（默认 false，建议保持关闭）
# OH_MY_SAGE_LOAD_USER_SKILLS=false
